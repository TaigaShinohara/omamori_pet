    <string name="ob_p4_fit_title">Omamori Pet fits you naturally.</string>
    <string name="ob_p4_undecided_title">Let\'s try just one calm minute together.</string>
    <string name="ob_p4_reflect_calm_watch">For calming racing moments at rest.</string>
    <string name="ob_p4_body_calm_watch">It ignores post-walk spikes and only nudges when you\'re truly still.</string>
    <string name="ob_p4_reflect_calm_phone">For settling sudden tension anytime.</string>
    <string name="ob_p4_body_calm_phone">Even without a watch, a 1-minute guided breath is one tap away.</string>
    <string name="ob_p4_reflect_calm_undecided">For calming moments when your heart feels quick.</string>
    <string name="ob_p4_body_calm_undecided">Start with 1-minute phone breathing and add a watch anytime later.</string>
    <string name="ob_p4_reflect_learn_watch">For learning your everyday calm rhythm.</string>
    <string name="ob_p4_body_learn_watch">It gently learns your resting baseline between your watch and phone.</string>
    <string name="ob_p4_reflect_learn_phone">For checking in with your calm rhythm.</string>
    <string name="ob_p4_body_learn_phone">Track your 1-minute breathing sessions and reflect on calm moments.</string>
    <string name="ob_p4_reflect_learn_undecided">For noticing how your calm rhythm feels.</string>
    <string name="ob_p4_body_learn_undecided">Log calm breaths daily now, and add watch sensing whenever you choose.</string>
    <string name="ob_p4_reflect_open_watch">For pairing gently with your Pixel Watch.</string>
    <string name="ob_p4_body_open_watch">Quiet watch awareness paired with gentle haptic breathing anytime.</string>
    <string name="ob_p4_reflect_open_phone">For trying gently on your phone first.</string>
    <string name="ob_p4_body_open_phone">No complex setup needed—begin a 1-minute breath right away.</string>
    <string name="ob_p4_reflect_open_undecided">No need to decide right away.</string>
    <string name="ob_p4_body_open_undecided">You can start a gentle breathing session right from your phone anytime.</string>

    <string name="ob_p5_title">A calm companion, never an alarm.</string>
    <string name="ob_p5_body">No scary warnings or scores—just a quiet guide beside you.</string>

    <string name="ob_p6_watch_title">Post-walk heart rate won\'t trigger alerts.</string>
    <string name="ob_p6_watch_body">It waits until you are still, so normal movement never feels like a false alarm.</string>
    <string name="ob_p6_phone_title">Settle in 1 minute, even without a watch.</string>
    <string name="ob_p6_phone_body">One tap opens a calm visual and haptic breath whenever you need a pause.</string>

