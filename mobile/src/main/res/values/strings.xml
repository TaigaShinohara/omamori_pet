    <string name="ob_p9_title">1. Glance</string>
    <string name="ob_p9_body">Check how calm things feel from Omamori Pet\'s color and expression.</string>
    <string name="ob_p10_title">2. Breathe</string>
    <string name="ob_p10_body">Inhale 4s, hold 2s, exhale 6s—just follow the gentle motion.</string>
    <string name="ob_p11_title">3. Reflect</string>
    <string name="ob_p11_body">Look back on your breathing sessions and quiet moments anytime.</string>

