<?xml version="1.0" encoding="utf-8"?>
<WatchFace
    clipShape="CIRCLE"
    height="450"
    width="450">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_COUNT_DISPLAY" value="FALSE" />

    <Scene backgroundColor="#FF11161D">
        <!-- WFF v2ではSceneの色を変換せず、Ambient専用の黒い背景を重ねる。 -->
        <PartDraw alpha="0" height="450" width="450" x="0" y="0">
            <Rectangle height="450" width="450" x="0" y="0">
                <Fill color="#FF000000" />
            </Rectangle>
            <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartDraw>

        <!-- 通常時の外周リングはAmbientで隠し、点灯面積を抑える。 -->
        <PartDraw
            alpha="255"
            height="450"
            width="450"
            x="0"
            y="0">
            <Ellipse
                height="422"
                width="422"
                x="14"
                y="14">
                <Stroke
                    color="#FF24303D"
                    thickness="8" />
            </Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>

        <!-- 要素 1（上部）：お守りペット状態スロット（4状態・非威圧） -->
        <ComplicationSlot
            displayName="@string/slot_pet_name"
            height="96"
            isCustomizable="TRUE"
            name="omamori_pet_slot"
            slotId="1"
            supportedTypes="RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE SHORT_TEXT EMPTY"
            width="140"
            x="155"
            y="32">
            <BoundingOval
                height="96"
                width="140"
                x="0"
                y="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.omamoripet.app/com.omamoripet.wear.complication.PetStateComplicationService"
                primaryProviderType="RANGED_VALUE" />

            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="is_external_ranged">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_MAX] > 3.5 || [COMPLICATION.RANGED_VALUE_MAX] < 2.5 || [COMPLICATION.RANGED_VALUE_MIN] > 0.5 || [COMPLICATION.RANGED_VALUE_MIN] < -0.5]]>
                        </Expression>
                        <Expression name="state_calm">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] < 0.5]]>
                        </Expression>
                        <Expression name="state_yellow">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 1.125]]>
                        </Expression>
                        <Expression name="state_red">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 1.25]]>
                        </Expression>
                        <Expression name="state_purple">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 1.375]]>
                        </Expression>
                        <Expression name="state_elevated">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 0.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 1.5 && [COMPLICATION.RANGED_VALUE_VALUE] != 1.125 && [COMPLICATION.RANGED_VALUE_VALUE] != 1.25 && [COMPLICATION.RANGED_VALUE_VALUE] != 1.375]]>
                        </Expression>
                        <Expression name="state_resting">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 1.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 2.5]]>
                        </Expression>
                        <Expression name="state_breathing_yellow">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 2.625]]>
                        </Expression>
                        <Expression name="state_breathing_red">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 2.75]]>
                        </Expression>
                        <Expression name="state_breathing_purple">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 2.875]]>
                        </Expression>
                    </Expressions>

                    <!-- 他社 RANGED_VALUE 差し替え時はテキスト表示へフォールバック -->
                    <Compare expression="is_external_ranged">
                        <PartText
                            alpha="240"
                            height="44"
                            width="140"
                            x="0"
                            y="26">
                            <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                                <Font
                                    color="#FFECE8DF"
                                    family="SYNC_TO_DEVICE"
                                    size="22"
                                    weight="MEDIUM">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </PartText>
                    </Compare>

                    <!-- 0: CALM（おだやか）＝お守り深緑・穏やかな視線 -->
                    <Compare expression="state_calm">
                        <Group name="petCalm" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#288FD3B6" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="68" width="68" x="14" y="14">
                                    <Fill color="#FF8FD3B6" />
                                </Ellipse>
                            </PartDraw>
                            <PartDraw alpha="255" angle="10" height="24" pivotX="0.5" pivotY="0.5" width="32" x="64" y="29">
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="16" width="8" x="4" y="3">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.2" cornerRadiusY="2.2" height="13" width="6" x="19" y="4">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <!-- Elevation colors use fractional codes inside the existing 0–3 range. -->
                    <Compare expression="state_yellow">
                        <Group name="petYellow" height="96" width="140" x="0" y="0">
                            <PartDraw height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#28DCCB8D" />
                                </Ellipse>
                                <Ellipse height="66" width="66" x="15" y="15">
                                    <Fill color="#FFDCCB8D" />
                                </Ellipse>
                            </PartDraw>
                            <PartDraw angle="-12" height="96" pivotX="0.395833" pivotY="0.479167" width="96" x="22" y="0">
                                <RoundRectangle cornerRadiusX="3" cornerRadiusY="3" height="9" width="17" x="29.5" y="41.5">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <PartDraw angle="12" height="96" pivotX="0.604167" pivotY="0.479167" width="96" x="22" y="0">
                                <RoundRectangle cornerRadiusX="3" cornerRadiusY="3" height="9" width="17" x="49.5" y="41.5">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <Compare expression="state_red">
                        <Group name="petRed" height="96" width="140" x="0" y="0">
                            <PartDraw height="96" width="96" x="22" y="0">
                                <Ellipse height="88" width="88" x="4" y="4">
                                    <Fill color="#28DDA0A0" />
                                </Ellipse>
                                <Ellipse height="78" width="78" x="9" y="9">
                                    <Stroke color="#8CDDA0A0" thickness="3.2" />
                                </Ellipse>
                                <Ellipse height="62" width="62" x="17" y="17">
                                    <Fill color="#FFDDA0A0" />
                                </Ellipse>
                            </PartDraw>
                            <PartDraw angle="-28" height="96" pivotX="0.395833" pivotY="0.500000" width="96" x="22" y="0">
                                <RoundRectangle cornerRadiusX="2.2" cornerRadiusY="2.2" height="5" width="18.4" x="28.8" y="45.5">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <PartDraw angle="28" height="96" pivotX="0.604167" pivotY="0.500000" width="96" x="22" y="0">
                                <RoundRectangle cornerRadiusX="2.2" cornerRadiusY="2.2" height="5" width="18.4" x="48.8" y="45.5">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <Compare expression="state_purple">
                        <Group name="petPurple" height="96" width="140" x="0" y="0">
                            <PartDraw height="96" width="96" x="22" y="0">
                                <Ellipse height="86" width="86" x="5" y="5">
                                    <Fill color="#28BBA4DC" />
                                </Ellipse>
                                <Ellipse height="76" width="76" x="10" y="10">
                                    <Stroke color="#8CBBA4DC" thickness="2.5" />
                                </Ellipse>
                                <Ellipse height="64" width="64" x="16" y="16">
                                    <Fill color="#FFBBA4DC" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2.2" cornerRadiusY="2.2" height="4.4" width="16.4" x="29.8" y="53">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.2" cornerRadiusY="2.2" height="4.4" width="16.4" x="49.8" y="53">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <!-- 1: ELEVATED_AT_REST（心拍が少し高め）＝おだやかと同じ緑・寄り添う正面目 -->
                    <Compare expression="state_elevated">
                        <Group name="petElevated" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#288FD3B6" />
                                </Ellipse>
                                <Ellipse height="74" width="74" x="11" y="11">
                                    <Stroke color="#998FD3B6" thickness="2.2" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="66" width="66" x="15" y="15">
                                    <Fill color="#FF8FD3B6" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="3" cornerRadiusY="3" height="15" width="11" x="34" y="39">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="3" cornerRadiusY="3" height="15" width="11" x="51" y="39">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <!-- 2: RESTING（待機中）＝静かなグレー・低い水平目 -->
                    <Compare expression="state_resting">
                        <Group name="petResting" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="80" width="80" x="8" y="8">
                                    <Fill color="#1A9AA6B2" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="66" width="66" x="15" y="15">
                                    <Fill color="#FF7B8896" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2" cornerRadiusY="2" height="4" width="14" x="30" y="51">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2" cornerRadiusY="2" height="4" width="14" x="52" y="51">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <!-- 2.625 / 2.75 / 2.875: BREATHING with condition color -->
                    <Compare expression="state_breathing_yellow">
                        <Group name="petBreathingYellow" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#28DCCB8D" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="68" width="68" x="14" y="14">
                                    <Fill color="#FFDCCB8D" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="29" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="51" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <Compare expression="state_breathing_red">
                        <Group name="petBreathingRed" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#28DDA0A0" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="68" width="68" x="14" y="14">
                                    <Fill color="#FFDDA0A0" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="29" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="51" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <Compare expression="state_breathing_purple">
                        <Group name="petBreathingPurple" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#28BBA4DC" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="68" width="68" x="14" y="14">
                                    <Fill color="#FFBBA4DC" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="29" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="51" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Compare>

                    <!-- 3 / Default: BREATHING（深呼吸中・緑）＝おだやかと同じ緑・水平な呼吸目 -->
                    <Default>
                        <Group name="petBreathing" alpha="255" height="96" pivotX="0.5" pivotY="0.5" width="140" x="0" y="0">
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="84" width="84" x="6" y="6">
                                    <Fill color="#288FD3B6" />
                                </Ellipse>
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                            </PartDraw>
                            <PartDraw alpha="255" height="96" width="96" x="22" y="0">
                                <Ellipse height="68" width="68" x="14" y="14">
                                    <Fill color="#FF8FD3B6" />
                                </Ellipse>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="29" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                                <RoundRectangle cornerRadiusX="2.5" cornerRadiusY="2.5" height="5.5" width="16" x="51" y="45">
                                    <Fill color="#FFFFFFFF" />
                                </RoundRectangle>
                            </PartDraw>
                            <Variant mode="AMBIENT" target="alpha" value="150" />
                        </Group>
                    </Default>
                </Condition>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage
                    alpha="255"
                    height="84"
                    width="84"
                    x="28"
                    y="6">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                </PartImage>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage
                    alpha="255"
                    height="78"
                    tintColor="#FFECE8DF"
                    width="78"
                    x="31"
                    y="9">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                </PartImage>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartText
                    alpha="240"
                    height="56"
                    width="140"
                    x="0"
                    y="20">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="2">
                        <Font
                            color="#FFECE8DF"
                            family="SYNC_TO_DEVICE"
                            size="18"
                            weight="MEDIUM">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 要素 2（中央）：時刻と日付 -->
        <DigitalClock
            alpha="255"
            height="100"
            width="320"
            x="65"
            y="120">
            <TimeText
                align="CENTER"
                format="hh:mm"
                height="86"
                hourFormat="SYNC_TO_DEVICE"
                width="320"
                x="0"
                y="0">
                <Font
                    color="#FFECE8DF"
                    family="SYNC_TO_DEVICE"
                    size="76"
                    weight="SEMI_BOLD" />
            </TimeText>
            <Variant mode="AMBIENT" target="alpha" value="175" />
        </DigitalClock>

        <PartText
            alpha="200"
            height="28"
            width="240"
            x="105"
            y="211">
            <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                <Font
                    color="#FFB4BCC4"
                    family="SYNC_TO_DEVICE"
                    size="20"
                    weight="NORMAL">
                    <Template>%s/%s %s<Parameter expression="[MONTH]" /><Parameter expression="[DAY]" /><Parameter expression="[DAY_OF_WEEK_S]" /></Template>
                </Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="120" />
        </PartText>

        <!-- 左にハートと状況、右に心拍数。旧スロット2の保存済み割当とは分離する。 -->
        <Group name="heartFrame" height="78" width="320" x="65" y="253">
            <PartDraw height="78" width="320" x="0" y="0">
                <RoundRectangle cornerRadiusX="39" cornerRadiusY="39" height="76" width="318" x="1" y="1">
                    <Fill color="#FF1B242F" />
                    <Stroke color="#FF2F3E4E" thickness="1.8" />
                </RoundRectangle>
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </PartDraw>
            <PartDraw height="34" width="36" x="49" y="10">
                <Arc centerX="9" centerY="10" height="16" width="16" startAngle="90" endAngle="270" direction="COUNTER_CLOCKWISE">
                    <Stroke color="#FF8FD3B6" thickness="2.8" cap="ROUND" />
                </Arc>
                <Arc centerX="25" centerY="10" height="16" width="16" startAngle="270" endAngle="90" direction="CLOCKWISE">
                    <Stroke color="#FF8FD3B6" thickness="2.8" cap="ROUND" />
                </Arc>
                <Line startX="1" startY="10" endX="17" endY="29">
                    <Stroke color="#FF8FD3B6" thickness="2.8" cap="ROUND" />
                </Line>
                <Line startX="33" startY="10" endX="17" endY="29">
                    <Stroke color="#FF8FD3B6" thickness="2.8" cap="ROUND" />
                </Line>
                <Variant mode="AMBIENT" target="alpha" value="150" />
            </PartDraw>
            <PartDraw height="48" width="2" x="148" y="15">
                <Line startX="1" startY="0" endX="1" endY="48">
                    <Stroke color="#FF526978" thickness="1.2" />
                </Line>
                <Variant mode="AMBIENT" target="alpha" value="100" />
            </PartDraw>
        </Group>
        <ComplicationSlot
            displayName="@string/slot_heart_name"
            height="78"
            isCustomizable="TRUE"
            name="heart_context_slot"
            slotId="3"
            supportedTypes="SHORT_TEXT EMPTY"
            width="320"
            x="65"
            y="253">
            <BoundingRoundBox cornerRadius="39" height="78" width="320" x="0" y="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.omamoripet.app/com.omamoripet.wear.complication.WatchFaceHeartRateComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText height="25" width="116" x="9" y="44">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font color="#FFB4BCC4" family="SYNC_TO_DEVICE" size="18" weight="NORMAL">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                </PartText>
                <PartText height="58" width="83" x="149" y="10">
                    <Text align="END" ellipsis="TRUE" maxLines="1">
                        <Font color="#FFECE8DF" family="SYNC_TO_DEVICE" size="42" weight="SEMI_BOLD">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="175" />
                </PartText>
                <PartText height="32" width="64" x="240" y="27">
                    <Text align="START" maxLines="1">
                        <Font color="#FFECE8DF" family="SYNC_TO_DEVICE" size="20" weight="MEDIUM">bpm</Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="175" />
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText height="25" width="116" x="9" y="44">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font color="#FFB4BCC4" family="SYNC_TO_DEVICE" size="18" weight="NORMAL">heart_waiting</Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                </PartText>
                <PartText height="58" width="83" x="149" y="10">
                    <Text align="END" ellipsis="TRUE" maxLines="1">
                        <Font color="#FFECE8DF" family="SYNC_TO_DEVICE" size="42" weight="SEMI_BOLD">--</Font>
                    </Text>
                    <Variant mode="AMBIENT" target="alpha" value="175" />
