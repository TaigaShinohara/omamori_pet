<?xml version="1.0" encoding="utf-8"?>
<WatchFace
    clipShape="CIRCLE"
    height="450"
    width="450">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_COUNT_DISPLAY" value="FALSE" />

    <Scene backgroundColor="#FF11161D">
        <!-- 外周の静かなリング（Ambient では抑える） -->
        <PartDraw
            alpha="255"
            height="450"
            width="450"
            x="0"
            y="0">
            <Variant mode="AMBIENT" target="alpha" value="60" />
            <Ellipse
                height="422"
                width="422"
                x="14"
                y="14">
                <Stroke
                    color="#FF24303D"
                    thickness="8" />
            </Ellipse>
        </PartDraw>

        <!-- 要素 1（上部）：お守りペット状態スロット -->
        <ComplicationSlot
            displayName="@string/slot_pet_name"
            height="96"
            isCustomizable="TRUE"
            name="omamori_pet_slot"
            slotId="1"
            supportedTypes="SMALL_IMAGE MONOCHROMATIC_IMAGE SHORT_TEXT EMPTY"
            width="140"
            x="155"
            y="42">
            <BoundingOval
                height="96"
                width="140"
                x="0"
                y="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.omamoripet.app/com.omamoripet.wear.complication.PetStateComplicationService"
                primaryProviderType="SMALL_IMAGE" />

            <Complication type="SMALL_IMAGE">
                <PartImage
                    alpha="255"
                    height="88"
                    width="88"
                    x="26"
                    y="4">
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage
                    alpha="255"
                    height="78"
                    tintColor="#FF8FD3B6"
                    width="78"
                    x="31"
                    y="9">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartText
                    alpha="240"
                    height="44"
                    width="140"
                    x="0"
                    y="26">
                    <Text align="CENTER">
                        <Font
                            color="#FFECE8DF"
                            family="SYNC_TO_DEVICE"
                            size="22"
                            weight="MEDIUM">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 要素 2（中央）：時刻と日付 -->
        <DigitalClock
            height="100"
            width="320"
            x="65"
            y="148">
            <TimeText
                align="CENTER"
                format="HH:mm"
                height="86"
                hourFormat="SYNC_TO_DEVICE"
                width="320"
                x="0"
                y="0">
                <Font
                    color="#FFECE8DF"
                    family="SYNC_TO_DEVICE"
                    size="76"
                    weight="SEMI_BOLD">
                    <Variant mode="AMBIENT" target="color" value="#FFA8A59E" />
                </Font>
            </TimeText>
        </DigitalClock>

        <PartText
            alpha="200"
            height="28"
            width="240"
            x="105"
            y="242">
            <Variant mode="AMBIENT" target="alpha" value="120" />
            <Text align="CENTER">
                <Font
                    color="#FFB4BCC4"
                    family="SYNC_TO_DEVICE"
                    size="20"
                    weight="NORMAL">
                    <Template>%s %s<Parameter expression="[MONTH_DAY_OF_MONTH]" /><Parameter expression="[DAY_OF_WEEK_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 要素 3（下部）：静止/移動文脈付き 心拍＆落ち着きゲージ -->
        <ComplicationSlot
            displayName="@string/slot_heart_name"
            height="92"
            isCustomizable="TRUE"
            name="heart_calm_slot"
            slotId="2"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            width="300"
            x="75"
            y="294">
            <BoundingRoundBox
                cornerRadius="46"
                height="92"
                width="300"
                x="0"
                y="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.omamoripet.app/com.omamoripet.wear.complication.HeartRateComplicationService"
                primaryProviderType="RANGED_VALUE" />

            <Complication type="RANGED_VALUE">
                <!-- ソフトなカプセル背景 -->
                <PartDraw
                    alpha="255"
                    height="78"
                    width="284"
                    x="8"
                    y="7">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle
                        cornerRadiusX="39"
                        cornerRadiusY="39"
                        height="78"
                        width="284"
                        x="0"
                        y="0">
                        <Fill color="#FF1B242F" />
                        <Stroke
                            color="#FF2F3E4E"
                            thickness="2" />
                    </RoundRectangle>
                    <!-- 落ち着きスコア RANGED_VALUE 進捗バー（下部トラック） -->
                    <RoundRectangle
                        cornerRadiusX="3"
                        cornerRadiusY="3"
                        height="5"
                        width="160"
                        x="62"
                        y="58">
                        <Fill color="#FF2A3644" />
                    </RoundRectangle>
                    <RoundRectangle
                        cornerRadiusX="3"
                        cornerRadiusY="3"
                        height="5"
                        width="[160 * ([COMPLICATION.RANGED_VALUE_VALUE] / 100)]"
                        x="62"
                        y="58">
                        <Fill color="#FF8FD3B6" />
                    </RoundRectangle>
                </PartDraw>

                <!-- 静止/移動文脈＋心拍・安静時差テキスト -->
                <PartText
                    alpha="255"
                    height="40"
                    width="268"
                    x="16"
                    y="16">
                    <Variant mode="AMBIENT" target="alpha" value="170" />
                    <Text align="CENTER">
                        <Font
                            color="#FFECE8DF"
                            family="SYNC_TO_DEVICE"
                            size="21"
                            weight="MEDIUM">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw
                    alpha="255"
                    height="72"
                    width="284"
                    x="8"
                    y="10">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle
                        cornerRadiusX="36"
                        cornerRadiusY="36"
                        height="72"
                        width="284"
                        x="0"
                        y="0">
                        <Fill color="#FF1B242F" />
                    </RoundRectangle>
                </PartDraw>
                <PartText
                    alpha="255"
                    height="44"
                    width="268"
                    x="16"
                    y="24">
                    <Variant mode="AMBIENT" target="alpha" value="170" />
                    <Text align="CENTER">
                        <Font
                            color="#FFECE8DF"
                            family="SYNC_TO_DEVICE"
                            size="21"
                            weight="MEDIUM">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
